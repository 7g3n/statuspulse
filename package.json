{
  "name": "statuspulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @statuspulse/web dev",
    "dev:mock": "pnpm --filter @statuspulse/web dev:mock",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase",
      "workerd"
    ]
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
